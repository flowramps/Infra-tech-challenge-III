# Copy to .env (ignored by Git) and fill in. The Makefile loads it.

# Optional Telegram channel for critical alerts (leave empty to disable).
# 1. Create a bot with @BotFather (/newbot) and paste the token below.
# 2. Send any message to the bot, then run: make telegram-chat-id
TF_VAR_telegram_bot_token=
TF_VAR_telegram_chat_id=
