    {
      "type": "logs",
      "title": "Application logs (click a trace_id to open it)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "refId": "A",
          "expr": "{namespace=\"sample-app\", container=\"app\", app=~\"$app\"} | json | msg != \"request handled\" or status >= 500"
