# One Alloy agent per node tails the container log files written by the
# runtime under /var/log/pods. Reading from the node keeps log collection off
# the API server and keeps working if the control plane is unavailable.
global:
  # Pod log files are root:root 0640 inside a root:root 0750 directory. The
  # agent reads them through the root *group* (supplementalGroups), so it runs
  # as a regular user with no capabilities instead of as root.
  podSecurityContext:
    runAsNonRoot: true
    runAsUser: 473
    runAsGroup: 473
    supplementalGroups: [0]
    seccompProfile:
      type: RuntimeDefault

controller:
  type: daemonset
  # Control plane nodes too: etcd, API server and scheduler logs matter for
  # troubleshooting and audits.
  tolerations:
    - key: node-role.kubernetes.io/control-plane
      operator: Exists
      effect: NoSchedule

  volumes:
    extra:
      - name: pod-logs
        hostPath:
          path: /var/log/pods
          type: Directory
      # Read positions survive agent restarts: no duplicated or lost lines.
      - name: data
        hostPath:
          path: /var/lib/alloy
          type: DirectoryOrCreate

  # The kubelet creates the hostPath directory owned by root. A short-lived
  # init container with only CAP_CHOWN hands it to the agent user.
  initContainers:
    - name: data-dir-owner
      image: busybox:1.37.0
      command: ["chown", "473:473", "/var/lib/alloy"]
      securityContext:
        runAsUser: 0
        runAsNonRoot: false
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true
        capabilities:
          drop: ["ALL"]
          add: ["CHOWN"]
      resources:
        requests: { cpu: 10m, memory: 8Mi }
        limits: { cpu: 50m, memory: 16Mi }
      volumeMounts:
        - name: data
          mountPath: /var/lib/alloy

alloy:
  storagePath: /var/lib/alloy
  mounts:
    extra:
      - name: pod-logs
        mountPath: /var/log/pods
        readOnly: true
      - name: data
        mountPath: /var/lib/alloy
  securityContext:
    allowPrivilegeEscalation: false
    readOnlyRootFilesystem: true
    capabilities:
      drop: ["ALL"]
  resources:
    requests: { cpu: 20m, memory: 64Mi }
    limits: { cpu: 300m, memory: 256Mi }
  configMap:
    content: |
      // Pods scheduled on this node only.
      discovery.kubernetes "pods" {
        role = "pod"
        selectors {
          role  = "pod"
          field = "spec.nodeName=" + sys.env("HOSTNAME")
        }
      }

      discovery.relabel "pods" {
        targets = discovery.kubernetes.pods.targets

        rule {
          source_labels = ["__meta_kubernetes_namespace"]
          target_label  = "namespace"
        }
        rule {
          source_labels = ["__meta_kubernetes_pod_name"]
          target_label  = "pod"
        }
        rule {
          source_labels = ["__meta_kubernetes_pod_container_name"]
          target_label  = "container"
        }
        rule {
          source_labels = ["__meta_kubernetes_pod_node_name"]
          target_label  = "node"
        }
        rule {
          source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name", "__meta_kubernetes_pod_label_app"]
          regex         = "^;*([^;]+)(;.*)?$"
          target_label  = "app"
        }
        // /var/log/pods/<namespace>_<pod>_<uid>/<container>/<restart>.log
        rule {
          source_labels = ["__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
          separator     = "/"
          target_label  = "__path__"
          replacement   = "/var/log/pods/*$1/*.log"
        }
        // Static pods (etcd, API server, scheduler, controller-manager) log
        // under the config hash exposed by their mirror pod annotation.
        rule {
          source_labels = ["__meta_kubernetes_pod_annotation_kubernetes_io_config_mirror", "__meta_kubernetes_pod_container_name"]
          separator     = "/"
          regex         = "^(.+)/(.+)$"
          target_label  = "__path__"
          replacement   = "/var/log/pods/*$1/$2/*.log"
        }
      }

      local.file_match "pods" {
        path_targets = discovery.relabel.pods.output
      }

      loki.source.file "pods" {
        targets    = local.file_match.pods.targets
        forward_to = [loki.process.pods.receiver]
      }

      loki.process "pods" {
        // Strip the CRI envelope (timestamp, stream, partial flag) and keep
        // the original log line and timestamp.
        stage.cri {}

        // Application logs are JSON: promote the level to a label and keep
        // the trace id as structured metadata for log <-> trace correlation.
        stage.match {
          selector = "{container=\"app\"}"

          stage.json {
            expressions = { level = "level", trace_id = "trace_id" }
          }
          stage.labels {
            values = { level = "" }
          }
          stage.structured_metadata {
            values = { trace_id = "" }
          }
        }

        forward_to = [loki.write.default.receiver]
      }

      loki.write "default" {
        endpoint {
          url = "${loki_push_url}"
        }
      }

serviceMonitor:
  enabled: true
