tempo:
  retention: ${retention}
  reportingEnabled: false
  # At 1Gi the process ran at the limit and was OOMKilled when queries read
  # blocks back. GOMEMLIMIT makes the Go GC work harder before the cgroup
  # limit is reached; it replaces the old memory ballast technique.
  memBallastSizeMbs: 0
  resources:
    requests: { cpu: 100m, memory: 512Mi }
    limits: { cpu: "1", memory: 2Gi }
  # Blocks go to the in-cluster object store (trace-storage.tf); the WAL
  # stays on the local volume. Credentials come from a Secret through env
  # vars, expanded by -config.expand-env.
  storage:
    trace:
      backend: s3
      s3:
        bucket: ${trace_bucket}
        endpoint: ${trace_store_host}
        insecure: true
        forcepathstyle: true
        access_key: $${S3_ACCESS_KEY}
        secret_key: $${S3_SECRET_KEY}
      wal:
        path: /var/tempo/wal
  # Cut blocks every 5 minutes: traces reach the object store quickly and the
  # ingester keeps less in memory (default is 30m).
  ingester:
    max_block_duration: 5m
  extraArgs:
    config.expand-env: true
  extraEnv:
    - name: GOMEMLIMIT
      value: "1600MiB"
    - name: S3_ACCESS_KEY
      valueFrom:
        secretKeyRef:
          name: ${trace_store_secret}
          key: access-key
    - name: S3_SECRET_KEY
      valueFrom:
        secretKeyRef:
          name: ${trace_store_secret}
          key: secret-key
  receivers:
    otlp:
      protocols:
        grpc:
          endpoint: "0.0.0.0:4317"
        http:
          endpoint: "0.0.0.0:4318"
  # Metrics generator:
  #   service-graphs, span-metrics -> pushed to Prometheus (service map, RED)
  #   local-blocks -> serves TraceQL metrics queries (`{...} | rate()`), used by
  #                   Grafana Traces Drilldown
  metricsGenerator:
    enabled: true
    remoteWriteUrl: ${prometheus_remote_write_url}
    processor:
      local_blocks:
        # Keep client spans too (Envoy and httpx), not only server spans.
        filter_server_spans: false
        flush_to_storage: true
    storage:
      path: /var/tempo/generator/wal
      remote_write:
        - url: ${prometheus_remote_write_url}
          send_exemplars: true
    traces_storage:
      path: /var/tempo/generator/traces
  overrides:
    defaults:
      metrics_generator:
        processors:
          - service-graphs
          - span-metrics
          - local-blocks

persistence:
  enabled: true
  storageClassName: ${storage_class}
  size: ${storage_size}

serviceMonitor:
  enabled: true
