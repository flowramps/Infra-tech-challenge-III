tempo:
  retention: ${retention}
  reportingEnabled: false
  resources:
    requests: { cpu: 100m, memory: 256Mi }
    limits: { cpu: "1", memory: 1Gi }
  receivers:
    otlp:
      protocols:
        grpc:
          endpoint: "0.0.0.0:4317"
        http:
          endpoint: "0.0.0.0:4318"
  # Metrics generator:
  #   service-graphs, span-metrics -> pushed to Prometheus (service map, RED)
  #   local-blocks -> serves TraceQL metrics queries (`{...} | rate()`), used by
  #                   Grafana Traces Drilldown
  metricsGenerator:
    enabled: true
    remoteWriteUrl: ${prometheus_remote_write_url}
    processor:
      local_blocks:
        # Keep client spans too (Envoy and httpx), not only server spans.
        filter_server_spans: false
        flush_to_storage: true
    storage:
      path: /var/tempo/generator/wal
      remote_write:
        - url: ${prometheus_remote_write_url}
          send_exemplars: true
    traces_storage:
      path: /var/tempo/generator/traces
  overrides:
    defaults:
      metrics_generator:
        processors:
          - service-graphs
          - span-metrics
          - local-blocks

persistence:
  enabled: true
  storageClassName: ${storage_class}
  size: ${storage_size}

serviceMonitor:
  enabled: true
